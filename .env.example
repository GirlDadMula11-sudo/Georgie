OPENAI_API_KEY=your_openai_api_key_here
PORT=3000
NODE_ENV=development
OPENAI_MODEL=gpt-5
OPENAI_MEMORY_MODEL=gpt-5
OPENAI_ROUTER_MODEL=gpt-5
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=cedar
GEORGIE_DATA_DIR=data
GEORGIE_AUTO_ACTION_POLICY=low_risk_write
GEORGIE_RATE_LIMIT=90
GEORGIE_PROACTIVE_INTERVAL_MS=30000
GEORGIE_REMINDER_LEAD_MS=600000

# Neo Mail is Georgie's primary email provider.
# Keep this value ONLY in your deployment secret manager / local .env. Never commit real passwords.
GEORGIE_NEO_MAILBOXES_JSON=[]
GEORGIE_NEO_IMAP_HOST=imap0001.neo.space
GEORGIE_NEO_IMAP_PORT=993
GEORGIE_NEO_SMTP_HOST=smtp0001.neo.space
GEORGIE_NEO_SMTP_PORT=465

# Georgie Mac Agent. Generate a long random token and use the exact same value
# on the Georgie server and the Mac agent. Never expose it publicly.
GEORGIE_MAC_AGENT_TOKEN=replace_with_a_long_random_secret
GEORGIE_MAC_DEVICE_ID=primary-mac
GEORGIE_SERVER_URL=https://your-georgie-server.example.com
GEORGIE_MAC_POLL_MS=5000

GEORGIE_CALENDAR_ENABLED=false
GEORGIE_WEB_ENABLED=false
GEORGIE_NOTIFICATIONS_ENABLED=false
