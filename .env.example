OPENAI_API_KEY=your_openai_api_key_here
PORT=3000
NODE_ENV=development
OPENAI_MODEL=gpt-5
OPENAI_MEMORY_MODEL=gpt-5
OPENAI_ROUTER_MODEL=gpt-5
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=cedar
GEORGIE_DATA_DIR=data
GEORGIE_AUTO_ACTION_POLICY=low_risk_write
GEORGIE_RATE_LIMIT=90
GEORGIE_PROACTIVE_INTERVAL_MS=30000
GEORGIE_REMINDER_LEAD_MS=600000
GEORGIE_EMAIL_ENABLED=false
GEORGIE_CALENDAR_ENABLED=false
GEORGIE_WEB_ENABLED=false
GEORGIE_NOTIFICATIONS_ENABLED=false
