OPENAI_API_KEY=your_openai_api_key_here
PORT=3000
NODE_ENV=development
# GPT-5.6 Sol handles Georgie's executive reasoning; Terra routes tool actions; Luna handles high-volume memory extraction.
OPENAI_MODEL=gpt-5.6
OPENAI_ROUTER_MODEL=gpt-5.6-terra
OPENAI_MEMORY_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_ROUTER_REASONING_EFFORT=low
OPENAI_VERBOSITY=medium
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=cedar
GEORGIE_DATA_DIR=data
GEORGIE_AUTO_ACTION_POLICY=low_risk_write
GEORGIE_RATE_LIMIT=90
GEORGIE_PROACTIVE_INTERVAL_MS=30000
GEORGIE_REMINDER_LEAD_MS=600000

# Durable Georgie state. Keep the service-role key ONLY in deployment secrets.
# If these are not configured, Georgie safely falls back to local/tmp storage.
GEORGIE_SUPABASE_URL=https://your-project.supabase.co
GEORGIE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Governed infrastructure administration. Never commit real values.
# Reuse the existing team-scoped Vercel token when it has the required RBAC permissions.
GEORGIE_VERCEL_TOKEN=
GEORGIE_VERCEL_TEAM_ID=
# Supabase Management API token is separate from the project service-role key.
GEORGIE_SUPABASE_MANAGEMENT_TOKEN=
GEORGIE_SUPABASE_ORGANIZATION_SLUG=
# Only configure this when Supabase exposes an official invitation endpoint for the account/plan.
# It must be an https://api.supabase.com/... URL and may contain {slug}.
GEORGIE_SUPABASE_MEMBER_INVITE_ENDPOINT=
# Master provider-write switch. Keep false until review and credential setup are complete.
GEORGIE_INFRA_ADMIN_WRITES_ENABLED=false

# Neo Mail is Georgie's primary email provider.
# Keep this value ONLY in your deployment secret manager / local .env. Never commit real passwords.
GEORGIE_NEO_MAILBOXES_JSON=[]
GEORGIE_NEO_IMAP_HOST=imap0001.neo.space
GEORGIE_NEO_IMAP_PORT=993
GEORGIE_NEO_SMTP_HOST=smtp0001.neo.space
GEORGIE_NEO_SMTP_PORT=465

# Georgie Mac Agent. Generate a long random token and use the exact same value
# on the Georgie server and the Mac agent. Never expose it publicly.
GEORGIE_MAC_AGENT_TOKEN=replace_with_a_long_random_secret
GEORGIE_MAC_DEVICE_ID=primary-mac
GEORGIE_SERVER_URL=https://your-georgie-server.example.com
GEORGIE_MAC_POLL_MS=5000

GEORGIE_CALENDAR_ENABLED=false
GEORGIE_WEB_ENABLED=true
GEORGIE_NOTIFICATIONS_ENABLED=false

# Secure Home-Screen notifications and provider-direct campaign monitoring.
GEORGIE_SMARTLEAD_API_KEY=
GEORGIE_VAPID_PUBLIC_KEY=
GEORGIE_VAPID_PRIVATE_KEY=
GEORGIE_VAPID_SUBJECT=mailto:operations@sierracapitalfunding.com
GEORGIE_MAINTENANCE_MODE=shadow
GEORGIE_REPAIR_CERT_HEALTHY_CYCLES=12
GEORGIE_MAC_RECEIPT_DEADLINE_MS=10000
GEORGIE_MAC_CLAIM_LEASE_MS=45000

# Durable financing recovery remains disabled and provider-held by default.
GEORGIE_FINANCING_RECOVERY_ENABLED=false
GEORGIE_FINANCING_OUTREACH_RELEASE=hold
GEORGIE_FINANCING_RECOVERY_INTERVAL_MS=15000
